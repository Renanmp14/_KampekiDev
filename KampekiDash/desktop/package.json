{
  "name": "kampeki-desktop",
  "version": "1.5.2",
  "description": "Kampeki Finance — aplicativo desktop (Windows)",
  "author": "Kampeki",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icon": "node build-icon.js",
    "check-env": "node check-env.js",
    "build:frontend": "npm --prefix ../frontend run build",
    "pack": "electron-builder",
    "dist": "node check-env.js && npm run build:frontend && electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kampeki.finance",
    "productName": "Kampeki Finance",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!build/**",
      "!dist/**",
      "!README-INSTALADOR.md"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!.env", "!.env.*", "!**/*.log"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      },
      {
        "from": "build/.env",
        "to": ".env"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "KampekiFinance-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kampeki Finance"
    }
  }
}
