# Modelo do arquivo de configuração do Kampeki Finance.
# - Em DESENVOLVIMENTO: copie para "desktop/build/.env" e preencha com os valores
#   reais (esse arquivo é ignorado pelo git e usado por `npm start`).
# - No COMPUTADOR DO CLIENTE: o arquivo ".env" preenchido é depositado na pasta de
#   configuração do app (o próprio app mostra o caminho exato se ele faltar):
#     Windows: %APPDATA%\Kampeki Finance\.env
#     macOS:   ~/Library/Application Support/Kampeki Finance/.env
#
# NUNCA cole valores reais neste .env.example (ele é versionado).

PORT=3001
NODE_ENV=production

JWT_SECRET=troque_por_string_aleatoria_longa_aqui
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@seudominio.local
ADMIN_PASSWORD=defina_uma_senha

GOOGLE_SHEET_ID=coloque_o_id_da_planilha

# JSON da Service Account em UMA ÚNICA LINHA.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"seu-projeto","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sua-conta@seu-projeto.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token","universe_domain":"googleapis.com"}

GROWTH_ALERT_THRESHOLD=20
