PORT=3001
NODE_ENV=development

JWT_SECRET=troque_por_uma_string_aleatoria_longa
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@kampeki.local
ADMIN_PASSWORD=admin@2026

# ID da planilha (parte da URL: docs.google.com/spreadsheets/d/<ESTE_ID>/edit)
GOOGLE_SHEET_ID=ID_DA_PLANILHA_AQUI

# JSON da Service Account em UMA linha (chave privada com \n escapados)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com"}

# Limite (%) de crescimento de item que dispara alerta visual no Dash Custos
GROWTH_ALERT_THRESHOLD=20
